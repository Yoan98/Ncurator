{
  "name": "ncurator",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:main": "vitest --config vitest.ai.config.mts run",
    "test:main:watch": "vitest --config vitest.ai.config.mts",
    "test:main:ai:capability": "vitest --config vitest.ai.config.mts run tests/main/ai/capability",
    "test:main:ai:capability:analyze": "node scripts/tool-capability-report-analyzer.mjs",
    "test:main:ai:runtime": "vitest --config vitest.ai.config.mts run tests/main/ai/runtime",
    "test:main:ai:human": "vitest --config vitest.ai.config.mts run tests/main/ai/human",
  "test:main:ai:human:analyze": "node scripts/human-report-analyzer.mjs",
  "test:main:ai:human:p2": "node scripts/human-batch-runner.mjs",
  "test:main:ai:human:p3:compare": "node scripts/human-batch-compare.mjs",
  "test:catalog:generate": "node scripts/generate-test-catalog.mjs",
  "test:catalog:clean-reports": "node scripts/clean-stale-test-reports.mjs",
  "test:main:workspace:service": "vitest --config vitest.ai.config.mts run tests/main/workspace/service",
    "test:main:workspace:migration": "vitest --config vitest.ai.config.mts run tests/main/workspace/migration",
    "test:ai": "vitest --config vitest.ai.config.mts run",
    "test:ai:watch": "vitest --config vitest.ai.config.mts",
    "test:renderer": "vitest --config vitest.renderer.config.mts run",
    "test:renderer:watch": "vitest --config vitest.renderer.config.mts",
    "test:e2e": "electron-vite build && vitest --config vitest.e2e.config.mts run tests/e2e/**/deterministic",
    "test:e2e:ai-live": "electron-vite build && vitest --config vitest.e2e.config.mts run tests/e2e/**/ai-live",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "^3.8.1",
    "@js-preview/docx": "^1.6.4",
    "@lancedb/lancedb": "^0.23.0",
    "@lancedb/lancedb-darwin-arm64": "^0.22.3",
    "@langchain/community": "^1.1.1",
    "@langchain/core": "^1.1.29",
    "@langchain/langgraph": "^1.1.5",
    "@langchain/openai": "^1.2.11",
    "@langchain/textsplitters": "^1.0.1",
    "@node-rs/jieba": "^2.0.1",
    "@react-pdf/renderer": "^4.1.0",
    "@xmldom/xmldom": "^0.8.11",
    "antd": "5.22.1",
    "apache-arrow": "^17.0.0",
    "cheerio": "^1.2.0",
    "docx": "^9.5.1",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "katex": "^0.16.28",
    "mammoth": "^1.11.0",
    "mark.js": "^8.11.1",
    "openai": "^6.16.0",
    "pdf-parse": "^2.4.5",
    "react-doc-viewer": "^0.1.15",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^13.0.0",
    "xpath": "^0.0.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^26.1.0",
    "less": "^4.5.1",
    "playwright": "^1.58.2",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  }
}
