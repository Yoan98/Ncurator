{
  "name": "ncurator",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:ai": "node scripts/test-workflow.mjs --domain ai --type backend",
    "test:ai:backend": "node scripts/test-workflow.mjs --domain ai --type backend",
    "test:ai:tool": "node scripts/test-workflow.mjs --domain ai --suite tool --type backend",
    "test:ai:human:mock-llm": "node scripts/test-workflow.mjs --domain ai --suite human --group mock-llm --type backend",
    "test:ai:human:live": "node scripts/test-workflow.mjs --domain ai --suite human --group live --type backend",
    "test:unit": "node scripts/test-workflow.mjs --domain unit --type backend",
    "test:unit:ai": "node scripts/test-workflow.mjs --domain unit --suite ai --type backend",
    "test:settings": "node scripts/test-workflow.mjs --domain settings",
    "test:settings:backend": "node scripts/test-workflow.mjs --domain settings --type backend",
    "test:settings:e2e": "node scripts/test-workflow.mjs --domain settings --type e2e",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "^3.8.1",
    "@js-preview/docx": "^1.6.4",
    "@lancedb/lancedb": "^0.23.0",
    "@lancedb/lancedb-darwin-arm64": "^0.22.3",
    "@langchain/community": "^1.1.1",
    "@langchain/core": "^1.1.44",
    "@langchain/deepseek": "^1.0.25",
    "@langchain/langgraph": "^1.1.5",
    "@langchain/openai": "^1.4.5",
    "@langchain/textsplitters": "^1.0.1",
    "@node-rs/jieba": "^2.0.1",
    "@react-pdf/renderer": "^4.1.0",
    "@xmldom/xmldom": "^0.8.11",
    "antd": "5.22.1",
    "apache-arrow": "^17.0.0",
    "cheerio": "^1.2.0",
    "docx": "^9.5.1",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "katex": "^0.16.28",
    "mammoth": "^1.11.0",
    "mark.js": "^8.11.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "5.4.296",
    "react-doc-viewer": "^0.1.15",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^13.0.0",
    "xpath": "^0.0.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^26.1.0",
    "less": "^4.5.1",
    "playwright": "^1.58.2",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  }
}
