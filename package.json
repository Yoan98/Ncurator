{
  "name": "ncurator",
  "version": "0.1.6",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "build:sidecar": "node scripts/build-web-crawler-sidecar.mjs",
    "test:ai": "node scripts/test-workflow.mjs --domain ai --type backend",
    "test:ai:backend": "node scripts/test-workflow.mjs --domain ai --type backend",
    "test:ai:tool": "node scripts/test-workflow.mjs --domain ai --suite tool --type backend",
    "test:ai:human:mock-llm": "node scripts/test-workflow.mjs --domain ai --suite human --group mock-llm --type backend",
    "test:ai:human:live": "node scripts/test-workflow.mjs --domain ai --suite human --group live --type backend",
    "test:unit": "node scripts/test-workflow.mjs --domain unit --type backend",
    "test:unit:ai": "node scripts/test-workflow.mjs --domain unit --suite ai --type backend",
    "test:settings": "node scripts/test-workflow.mjs --domain settings",
    "test:settings:backend": "node scripts/test-workflow.mjs --domain settings --type backend",
    "test:settings:e2e": "node scripts/test-workflow.mjs --domain settings --type e2e",
    "test:update": "pnpm run test:update:backend && pnpm run test:update:e2e",
    "test:update:backend": "node scripts/test-workflow.mjs --domain settings --suite update --type backend",
    "test:update:e2e": "node scripts/test-workflow.mjs --domain settings --suite update --type e2e",
    "test:update:real": "node scripts/test-app-update-real.mjs",
    "release:start": "node scripts/prepare-desktop-release.mjs",
    "release:win": "node scripts/release-windows-local.mjs",
    "release:win:auto": "node scripts/route-windows-release.mjs",
    "release:doctor": "node scripts/release-doctor.mjs",
    "release:status": "node scripts/release-status.mjs",
    "release:signing:setup": "node scripts/setup-mac-update-signing.mjs",
    "release:mac": "node scripts/release-macos-local.mjs",
    "release:mac:only": "node scripts/release-macos-local.mjs --mac-only",
    "release:r2:finalize": "node scripts/finalize-r2-release.mjs",
    "test:workbench": "node scripts/test-workflow.mjs --domain workbench",
    "test:workbench:backend": "node scripts/test-workflow.mjs --domain workbench --type backend",
    "test:workbench:e2e": "node scripts/test-workflow.mjs --domain workbench --type e2e",
    "start": "electron-vite preview",
    "dev": "node scripts/prepare-better-sqlite3-native.mjs ensure electron && node scripts/ensure-web-crawler-sidecar.mjs && electron-vite dev",
    "dev:no-sidecar": "node scripts/prepare-better-sqlite3-native.mjs ensure electron && electron-vite dev",
    "build": "node scripts/prepare-better-sqlite3-native.mjs ensure node && tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && node scripts/build-web-crawler-sidecar.mjs && node scripts/prepare-better-sqlite3-native.mjs export-electron-resource && electron-vite build && node scripts/verify-runtime-bundles.mjs && node scripts/prepare-package-stage.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "package:audit:stage": "node scripts/audit-package-stage.mjs",
    "package:audit": "node scripts/audit-packaged-app.mjs dist",
    "package:audit:summary": "node scripts/print-package-audit-summary.mjs dist/package-audit.json",
    "build:unpack": "pnpm run build && electron-builder --dir && pnpm run package:audit",
    "build:win": "node scripts/prepare-electron-builder-windows.mjs && pnpm run build && electron-builder --win --x64 --publish never && pnpm run package:audit",
    "build:mac": "pnpm run build && electron-builder --mac --publish never && pnpm run package:audit",
    "build:mac:x64": "pnpm run build && electron-builder --mac --x64 --publish never && pnpm run package:audit",
    "build:mac:arm64": "pnpm run build && electron-builder --mac --arm64 --publish never && pnpm run package:audit",
    "build:mac:release:x64": "pnpm run build && electron-builder --mac --x64 --publish never --config.forceCodeSigning=true && pnpm run package:audit",
    "build:mac:release:arm64": "pnpm run build && electron-builder --mac --arm64 --publish never --config.forceCodeSigning=true && pnpm run package:audit",
    "build:linux": "pnpm run build && electron-builder --linux && pnpm run package:audit",
    "native:node": "node scripts/prepare-better-sqlite3-native.mjs ensure node",
    "native:electron": "node scripts/prepare-better-sqlite3-native.mjs ensure electron",
    "native:status": "node scripts/prepare-better-sqlite3-native.mjs status",
    "native:prepare": "node scripts/prepare-better-sqlite3-native.mjs prepare",
    "native:clean": "node scripts/prepare-better-sqlite3-native.mjs clean"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@browserbasehq/stagehand": "^3.5.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "^3.8.1",
    "@js-preview/docx": "^1.6.4",
    "@lancedb/lancedb": "0.22.3",
    "@langchain/community": "^1.1.1",
    "@langchain/core": "^1.1.44",
    "@langchain/deepseek": "^1.0.25",
    "@langchain/langgraph": "^1.1.5",
    "@langchain/openai": "^1.4.5",
    "@langchain/textsplitters": "^1.0.1",
    "@node-rs/jieba": "^2.0.1",
    "@react-pdf/renderer": "^4.1.0",
    "@xmldom/xmldom": "^0.8.11",
    "antd": "5.22.1",
    "apache-arrow": "^17.0.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "docx": "^9.5.1",
    "electron-updater": "^6.3.9",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.28",
    "mammoth": "^1.11.0",
    "mark.js": "^8.11.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "5.4.296",
    "react-doc-viewer": "^0.1.15",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^13.0.0",
    "xpath": "^0.0.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "3.4.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^26.1.0",
    "less": "^4.5.1",
    "playwright": "^1.58.2",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18",
    "yaml": "2.8.2"
  },
  "packageManager": "pnpm@9.12.2+sha512.22721b3a11f81661ae1ec68ce1a7b879425a1ca5b991c975b074ac220b187ce56c708fe5db69f4c962c989452eee76c82877f4ee80f474cebd61ee13461b6228"
}
