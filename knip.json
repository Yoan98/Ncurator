{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/**/*.{mjs,mts,js}", "tests/harness/backend/docxVisualHost.ts"],
  "project": [
    "src/**/*.{ts,tsx}",
    "src/**/*.d.ts",
    "scripts/**/*.{mjs,mts,js}",
    "tests/**/*.{ts,tsx}",
    "!tests/fixtures/**"
