类型定义：
type DocxEditAction = DocxInsertBlocksAction | DocxReplaceBlockAction | DocxReplaceTextAction | DocxStyleAction | DocxUpdateTableCellAction | DocxDeleteBlocksAction
type DocxInsertBlocksAction = { type: "insert_blocks", location?: DocxBlockLocation, blocks: DocxCreateBlock[] }
type DocxBlockLocation = { blockId: string, position: "before" | "after" }
type DocxCreateBlock = DocxCreateParagraph | DocxCreateTable
type DocxCreateParagraph = { type: "paragraph", style?: DocxParagraphStyle, children: (DocxCreateRun | DocxCreateHyperlink)[] }
type DocxParagraphStyle = { styleName?: string, alignment?: "left" | "center" | "right" | "justify", indent?: { left?: number, right?: number, firstLine?: number, hanging?: number }, spacing?: { before?: number, after?: number, line?: number }, keepWithNext?: boolean, pageBreakBefore?: boolean }
type DocxCreateRun = { type: "run", style?: DocxRunStyle, children: (DocxCreateText | DocxCreateTab | DocxCreateBreak)[] }
type DocxRunStyle = { color?: string, bold?: boolean, italic?: boolean, underline?: boolean, strike?: boolean, highlight?: string, fontFamily?: string, fontSize?: number }
type DocxCreateText = { type: "text", text: string }
type DocxCreateTab = { type: "tab" }
type DocxCreateBreak = { type: "break", kind?: "line" | "page" | "column" }
type DocxCreateHyperlink = { type: "hyperlink", target?: string, anchor?: string, children: DocxCreateRun[] }
type DocxCreateTable = { type: "table", style?: DocxTableStyle, children: DocxCreateTableRow[] }
type DocxTableStyle = { alignment?: "left" | "center" | "right", width?: { value: number, unit: "pt" | "percent" }, layout?: "fixed" | "autofit", borders?: { top?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, right?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, bottom?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, left?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideHorizontal?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideVertical?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number } } }
type DocxCreateTableRow = { type: "table_row", style?: DocxTableRowStyle, children: DocxCreateTableCell[] }
type DocxTableRowStyle = { height?: number, repeatHeader?: boolean, cantSplit?: boolean }
type DocxCreateTableCell = { type: "table_cell", style?: DocxTableCellStyle, children: DocxCreateBlock[] }
type DocxTableCellStyle = { width?: { value: number, unit: "pt" | "percent" }, verticalAlignment?: "top" | "center" | "bottom", shading?: string, margins?: { top?: number, right?: number, bottom?: number, left?: number }, borders?: { top?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, right?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, bottom?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, left?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideHorizontal?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideVertical?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number } } }
type DocxReplaceBlockAction = { type: "replace_block", blockId: string, block: DocxCreateBlock, allowVisualLoss?: true }
type DocxReplaceTextAction = { type: "replace_text", query: string, replace: string, blockIds?: string[] }
type DocxStyleAction = { type: "style", target: DocxStyleTarget, patch: DocxStylePatch }
type DocxStyleTarget = { type: "text_match", query: string, blockIds?: string[] } | { type: "block", blockId: string } | { type: "node", nodeId: string }
type DocxStylePatch = { kind: "run", color?: string | null, bold?: boolean | null, italic?: boolean | null, underline?: boolean | null, strike?: boolean | null, highlight?: string | null, fontFamily?: string | null, fontSize?: number | null } | { styleName?: string | null, alignment?: "left" | "center" | "right" | "justify" | null, indent?: { left?: number, right?: number, firstLine?: number, hanging?: number } | null, spacing?: { before?: number, after?: number, line?: number } | null, keepWithNext?: boolean | null, pageBreakBefore?: boolean | null, kind: "paragraph" } | { kind: "table", alignment?: "left" | "center" | "right" | null, width?: { value: number, unit: "pt" | "percent" } | null, layout?: "fixed" | "autofit" | null, borders?: { top?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, right?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, bottom?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, left?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideHorizontal?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideVertical?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number } } | null } | { kind: "table_row", height?: number | null, repeatHeader?: boolean | null, cantSplit?: boolean | null } | { kind: "table_cell", width?: { value: number, unit: "pt" | "percent" } | null, verticalAlignment?: "top" | "center" | "bottom" | null, shading?: string | null, margins?: { top?: number, right?: number, bottom?: number, left?: number } | null, borders?: { top?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, right?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, bottom?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, left?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideHorizontal?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideVertical?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number } } | null }
