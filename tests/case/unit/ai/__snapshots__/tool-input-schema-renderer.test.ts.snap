类型定义：
type DocxEditAction = { type: "insert_blocks", blockId?: string, position?: "before" | "after", blocks: ({ text: string, style?: DocxParagraphStyle } | { rows: string[][], style?: DocxTableStyle })[] } | { type: "replace_block", blockId: string, block: { text: string, style?: DocxParagraphStyle } | { rows: string[][], style?: DocxTableStyle }, allowVisualLoss?: true } | { type: "replace_text", query: string, replace: string, blockIds?: string[] } | { type: "delete_blocks", blockIds: string[], allowVisualLoss?: true } | { type: "update_table_cell", cellBlockId: string, blocks: ({ text: string, style?: DocxParagraphStyle } | { rows: string[][], style?: DocxTableStyle })[], allowVisualLoss?: true } | { type: "style_text", query: string, blockIds?: string[], style: DocxRunStyle } | { type: "style_paragraph", id: string, style: DocxParagraphStyle } | { type: "style_table", id: string, style: DocxTableStyle } | { type: "style_row", id: string, style: DocxTableRowStyle } | { type: "style_cell", id: string, style: DocxTableCellStyle }
type DocxParagraphStyle = { styleName?: string, alignment?: "left" | "center" | "right" | "justify", indent?: { left?: number, right?: number, firstLine?: number, hanging?: number }, spacing?: { before?: number, after?: number, line?: number }, keepWithNext?: boolean, pageBreakBefore?: boolean }
type DocxTableStyle = { alignment?: "left" | "center" | "right", width?: { value: number, unit: "pt" | "percent" }, layout?: "fixed" | "autofit", borders?: { top?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, right?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, bottom?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, left?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideHorizontal?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideVertical?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number } } }
type DocxRunStyle = { color?: string, bold?: boolean, italic?: boolean, underline?: boolean, strike?: boolean, highlight?: string, fontFamily?: string, fontSize?: number }
type DocxTableRowStyle = { height?: number, repeatHeader?: boolean, cantSplit?: boolean }
type DocxTableCellStyle = { width?: { value: number, unit: "pt" | "percent" }, verticalAlignment?: "top" | "center" | "bottom", shading?: string, margins?: { top?: number, right?: number, bottom?: number, left?: number }, borders?: { top?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, right?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, bottom?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, left?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideHorizontal?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number }, insideVertical?: { style: "none" | "single" | "dashed" | "dotted" | "double", color?: string, size?: number } } }",
  "ppt_edit": "{ sourcePath: string, actions: PptEditAction[] }
类型定义：
type PptEditAction = { type: "insert_slide", location?: PptSlideLocation, html: string } | { type: "delete_slides", slideIds: string[] } | { type: "move_slide", slideId: string, location: PptSlideLocation } | { type: "duplicate_slide", slideId: string, location?: PptSlideLocation } | { type: "replace_text", query: string, replace: string, slideIds?: string[] } | { type: "edit_elements", slideId: string, operations: PptElementOperation[] } | { type: "set_notes", slideId: string, text: string }
type PptSlideLocation = { slideId: string, position: "before" | "after" }
type PptElementOperation = { type: "set_text", elementId: string, text: string } | { type: "set_bounds", elementId: string, bounds: PptBounds } | { type: "set_style", elementId: string, style: PptElementStyle } | { type: "set_z_order", elementId: string, placement: "front" | "back" | "forward" | "backward" } | { type: "delete_element", elementId: string } | { type: "duplicate_element", elementId: string } | { type: "add_element", element: PptElement } | { type: "replace_image", elementId: string, assetPath: string, fit?: "contain" | "cover" | "stretch" } | { type: "update_table", elementId: string, cells: { rowIndex: number, columnIndex: number, text: string }[] } | { type: "update_chart", elementId: string, chartType: "bar" | "column" | "line" | "pie" | "doughnut" | "area", categories: string[], series: PptChartSeries[], title?: string } | { type: "update_formula", elementId: string, latex: string }
type PptBounds = { x: number, y: number, width: number, height: number }
type PptElementStyle = { fill?: string, stroke?: string, strokeWidth?: number, color?: string, fontFamily?: string, fontSize?: number, bold?: boolean, italic?: boolean, underline?: boolean, textAlign?: "left" | "center" | "right", verticalAlign?: "top" | "middle" | "bottom", rotation?: number, shadow?: boolean }
type PptElement = { type: "text", text: string, bounds: PptBounds, style?: PptElementStyle } | { type: "shape", shape: "rect" | "roundRect" | "ellipse" | "triangle" | "chevron" | "arrow", bounds: PptBounds, text?: string, style?: PptElementStyle } | { type: "line", from: PptPoint, to: PptPoint, color?: string, width?: number, arrowEnd?: boolean } | { type: "image", assetPath: string, bounds: PptBounds, fit?: "contain" | "cover" | "stretch" } | { type: "table", bounds: PptBounds, rows: string[][] } | { type: "chart", bounds: PptBounds, chartType: "bar" | "column" | "line" | "pie" | "doughnut" | "area", categories: string[], series: PptChartSeries[], title?: string } | { type: "formula", latex: string, bounds: PptBounds }
type PptPoint = { x: number, y: number }
type PptChartSeries = { name: string, values: number[] }",
