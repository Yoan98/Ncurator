  "ppt_edit": "{ sourcePath: string, actions: PptEditAction[] }
类型定义：
type PptEditAction = { type: "insert_slide", location?: PptSlideLocation, html: string } | { type: "delete_slides", slideIds: string[] } | { type: "move_slide", slideId: string, location: PptSlideLocation } | { type: "duplicate_slide", slideId: string, location?: PptSlideLocation } | { type: "replace_text", query: string, replace: string, slideIds?: string[] } | { type: "edit_elements", slideId: string, operations: PptElementOperation[] } | { type: "set_notes", slideId: string, text: string }
type PptSlideLocation = { slideId: string, position: "before" | "after" }
type PptElementOperation = { type: "set_text", elementId: string, text: string } | { type: "set_bounds", elementId: string, bounds: PptBounds } | { type: "set_style", elementId: string, style: PptElementStyle } | { type: "set_z_order", elementId: string, placement: "front" | "back" | "forward" | "backward" } | { type: "delete_element", elementId: string } | { type: "duplicate_element", elementId: string } | { type: "add_element", element: PptElement } | { type: "replace_image", elementId: string, assetPath: string, fit?: "contain" | "cover" | "stretch" } | { type: "update_table", elementId: string, cells: { rowIndex: number, columnIndex: number, text: string }[] } | { type: "update_chart", elementId: string, chartType: "bar" | "column" | "line" | "pie" | "doughnut" | "area", categories: string[], series: PptChartSeries[], title?: string } | { type: "update_formula", elementId: string, latex: string }
type PptBounds = { x: number, y: number, width: number, height: number }
type PptElementStyle = { fill?: string, stroke?: string, strokeWidth?: number, color?: string, fontFamily?: string, fontSize?: number, bold?: boolean, italic?: boolean, underline?: boolean, textAlign?: "left" | "center" | "right", verticalAlign?: "top" | "middle" | "bottom", rotation?: number, shadow?: boolean }
type PptElement = { type: "text", text: string, bounds: PptBounds, style?: PptElementStyle } | { type: "shape", shape: "rect" | "roundRect" | "ellipse" | "triangle" | "chevron" | "arrow", bounds: PptBounds, text?: string, style?: PptElementStyle } | { type: "line", from: PptPoint, to: PptPoint, color?: string, width?: number, arrowEnd?: boolean } | { type: "image", assetPath: string, bounds: PptBounds, fit?: "contain" | "cover" | "stretch" } | { type: "table", bounds: PptBounds, rows: string[][] } | { type: "chart", bounds: PptBounds, chartType: "bar" | "column" | "line" | "pie" | "doughnut" | "area", categories: string[], series: PptChartSeries[], title?: string } | { type: "formula", latex: string, bounds: PptBounds }
type PptPoint = { x: number, y: number }
type PptChartSeries = { name: string, values: number[] }",
