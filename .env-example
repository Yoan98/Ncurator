# AI live 测试：内置服务商只配 Key；默认 dashscope + qwen3.8-flash
AI_LIVE_KEY_DEEPSEEK=
AI_LIVE_KEY_DASHSCOPE=
AI_LIVE_KEY_MIMO=
AI_LIVE_KEY_ZHIPU=

AI_LIVE_PROVIDER=dashscope
AI_LIVE_MODEL=qwen3.8-flash

# LangSmith tracing（默认关闭；排查时手动改为 true）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ncurator
LANGSMITH_API_KEY=
LANGCHAIN_CALLBACKS_BACKGROUND=true

# 国内 COS 发布（桶、地域、下载域名已固化在代码中）
SecretId=
SecretKey=

# 海外 R2 备用
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://download.ncurator.com

# macOS 安装包签名
CSC_LINK=
CSC_KEY_PASSWORD=

# 官网 App 网关（与 ncurator-official 的 NCURATOR_APP_SECRET_DESKTOP 相同）
# 生产构建会写入主进程包内；网关目录/埋点开关关闭时多出来的头会被忽略
NCURATOR_APP_SECRET_DESKTOP=
