# AI 测试（human）配置示例
# 用法：复制本文件为项目根目录 .env，然后填写真实值
# 只要提供可用 live 配置，测试就会默认直连模型

# `AI_LIVE_BASE_URL` 请填写 OpenAI 兼容端点；如果是网关首页地址，系统会自动规范到 `.../v1`
AI_LIVE_BASE_URL=
# 默认 pair baseline，可按需要替换
AI_LIVE_PRIMARY_MODEL_NAME=gpt-5
AI_LIVE_STRONG_MODEL_NAME=gpt-5.2
AI_LIVE_API_KEY=

# LangSmith tracing（仅开发环境主进程读取）
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ncurator
LANGSMITH_API_KEY=REMOVED_HISTORICAL_KEY
LANGCHAIN_CALLBACKS_BACKGROUND=true
