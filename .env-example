# 复制为 .env，权限设为 600。

# 国内桌面源码联调
# local / production 必填；两项目分别配置并重启，不互相控制进程。
NCURATOR_SERVICE_ENV=local
NCURATOR_LOCAL_API_ORIGIN=http://127.0.0.1:6010
NCURATOR_LOCAL_WEB_ORIGIN=http://127.0.0.1:5998
NCURATOR_PRODUCTION_API_ORIGIN=https://api.guanzhangai.cn
NCURATOR_PRODUCTION_WEB_ORIGIN=https://www.guanzhangai.cn
# 本文件复制为 .env 后，此处仅填写匹配生产 API 的桌面 Key。
# local 的同名 Key 只写入 .env.local，不继承进程 Key，不从另一文件回退。
# 本地服务重建后，用 scripts/dev/sync-local-service-env.mjs 同步其客户端配置。
NCURATOR_APP_SECRET_DESKTOP=

# AI 真实模型回归
AI_LIVE_PROVIDER=dashscope
AI_LIVE_MODEL=qwen3.8-flash
AI_LIVE_KEY_DEEPSEEK=
AI_LIVE_KEY_DASHSCOPE=
AI_LIVE_KEY_MIMO=
AI_LIVE_KEY_ZHIPU=
# 自定义 OpenAI 兼容入口使用 AI_LIVE_PROVIDER=custom。
AI_LIVE_BASE_URL=
AI_LIVE_API_KEY=

# LangSmith 诊断
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ncurator
LANGSMITH_API_KEY=
LANGCHAIN_CALLBACKS_BACKGROUND=true

# 发行包 App Key，按国内和国际分别写入安装包配置
NCURATOR_APP_SECRET_DOMESTIC=
NCURATOR_APP_SECRET_INTERNATIONAL=

# Mac 更新签名，CSC_LINK 是本机 P12 文件路径
CSC_LINK=
CSC_KEY_PASSWORD=
# 仅在需要指定本机签名身份时填写。
CSC_NAME=
CSC_IDENTITY_AUTO_DISCOVERY=

# 发布到国内 COS
SecretId=
SecretKey=

# 发布到海外 R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://download.ncurator.com

# 发布到 GitHub Releases。留空时使用 gh 已保存的登录凭证。
GH_TOKEN=
