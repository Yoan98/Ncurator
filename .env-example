AI_LIVE_PRIMARY_MODEL_NAME=deepseek-v4-flash-vision-exp
# AI_LIVE_PRIMARY_MODEL_NAME=deepseek-v4-flash

# LangSmith tracing（默认关闭；排查时手动改为 true）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ncurator
LANGSMITH_API_KEY=
LANGCHAIN_CALLBACKS_BACKGROUND=true

# Release（国内 COS 为默认发布目标；不要提交真实密钥）
RELEASE_STORAGE_TARGET=cos
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=ncurator-1324873382
COS_REGION=ap-guangzhou
COS_PUBLIC_BASE_URL=https://download.guanzhangai.cn
# 仅在明确执行真实发布时临时设置，普通打包和 dry-run 必须留空。
NCURATOR_ALLOW_LIVE_PUBLISH=

# 海外 R2 备用发布目标
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
