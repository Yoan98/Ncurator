# AI 测试（human-live）本地配置

#! ice
# AI_LIVE_BASE_URL=https://ice.v.ua
# AI_LIVE_API_KEY=REMOVED_HISTORICAL_KEY


AI_LIVE_PRIMARY_MODEL_NAME=gpt-5.4-mini
AI_LIVE_VISUAL_MODEL_NAME=qwen3.6-plus
AI_LIVE_VISION_BASE_URL=${AI_LIVE_BASE_URL}
AI_LIVE_VISION_API_KEY=${AI_LIVE_API_KEY}

# 结构化输出降级 live case（只在本机 .env 填写真实 key，不要提交密钥）
AI_STRUCTURED_FALLBACK_BASE_URL=https://api.deepseek.com
AI_STRUCTURED_FALLBACK_API_KEY=
AI_STRUCTURED_FALLBACK_MODEL_NAME=deepseek-chat

# LangSmith tracing（默认关闭；排查时手动改为 true）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ncurator
LANGSMITH_API_KEY=REMOVED_HISTORICAL_KEY
LANGCHAIN_CALLBACKS_BACKGROUND=true
